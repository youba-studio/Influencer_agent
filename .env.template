# ==============================================================================
# Environment Configuration Template for Anaya Sharma AI Influencer Agent
# Rename or copy this file to `.env` in the same directory:
#   cp .env.template .env
# ==============================================================================

# 1. Google Gemini API Configuration (Content, Prompting, Hinglish Caption Generator)
GOOGLE_API_KEY=your_gemini_api_key_here

# 2. Hugging Face Access Token (Model weights, Wan2.2 checkpoints)
HF_TOKEN=hf_your_huggingface_token_here

# 3. Instagram Credentials (instagrapi login or Meta Graph API credentials)
INSTAGRAM_USER=your_instagram_username
INSTAGRAM_PASS=your_instagram_password

# 4. Kaggle API Credentials (GPU Notebook runner for Wan2.2 rendering)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# 5. Google Colab / GDrive Integration (Optional fallback for Colab execution)
COLAB_WEBHOOK_URL=https://your-colab-ngrok-or-webhook-service.com/generate

# 6. EarnKaro Affiliate API & Linktree Management
EARNKARO_API_KEY=your_earnkaro_api_key
LINKTREE_ACCOUNT_ID=your_linktree_account_or_slug
